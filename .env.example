# Autoscaler runtime
# For local run against port-forwarded Prometheus, use: http://localhost:9090
PROMETHEUS_URL=http://prometheus:9090
TARGET_NAMESPACE=thesis-autoscaling
TARGET_DEPLOYMENT=demo-app

# Scaling bounds and loop
MIN_REPLICAS=1
MAX_REPLICAS=10
POLL_INTERVAL_SECONDS=15

# SLO thresholds
LATENCY_P95_THRESHOLD=0.40
ERROR_RATE_THRESHOLD=0.05
INPROGRESS_THRESHOLD=8

PER_REPLICA_RPS_THRESHOLD=15

# Step limits and cooldowns
SCALE_UP_STEP=1
SCALE_DOWN_STEP=1
SCALE_UP_COOLDOWN_SECONDS=30
SCALE_DOWN_COOLDOWN_SECONDS=120
MIN_SCALE_ACTION_INTERVAL_SECONDS=20
SCALE_DIRECTION_CHANGE_COOLDOWN_SECONDS=90
SCALE_DOWN_RELEASE_MARGIN=0.85

# Audit output
AUDIT_LOG_PATH=/tmp/autoscaler/audit.jsonl
AUDIT_DB_BACKEND=sqlite
AUDIT_DB_PATH=/tmp/autoscaler/audit.db
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=autoscaler
AUDIT_DB_USER=autoscaler
AUDIT_DB_PASSWORD=autoscaler

# OpenAI agent
OPENAI_AGENT_ENABLED=false
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=10
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_INPUT_COST_PER_1M_TOKENS=0
OPENAI_OUTPUT_COST_PER_1M_TOKENS=0
OPENAI_MAX_TOTAL_COST_USD=0
OPENAI_MAX_TOTAL_TOKENS=0

# Arbitration weights
WEIGHT_LATENCY=0.30
WEIGHT_ERROR=0.25
WEIGHT_SATURATION=0.15
WEIGHT_THROUGHPUT=0.15
WEIGHT_COST=0.10
WEIGHT_AGENT_DISAGREEMENT=0.20

# Expected action effects
ACTION_EFFECT_UP=0.80
ACTION_EFFECT_HOLD=1.00
ACTION_EFFECT_DOWN=1.20

# Channel logging
LOG_DIR=artifacts/logs/autoscaler
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
# channels: lifecycle, errors, metrics, agents, arbitration, safety, scaling, audit
