# Autoscaler runtime
# For local run against port-forwarded Prometheus, use: http://localhost:9090
PROMETHEUS_URL=http://prometheus:9090
TARGET_NAMESPACE=thesis-autoscaling
TARGET_DEPLOYMENT=demo-app

# Scaling bounds and loop
MIN_REPLICAS=2
MAX_REPLICAS=20
SOFT_REPLICA_CEILING=12
POLL_INTERVAL_SECONDS=3.5

# SLO thresholds
LATENCY_P95_THRESHOLD=0.40
ERROR_RATE_THRESHOLD=0.05
INPROGRESS_THRESHOLD=8

PER_REPLICA_RPS_THRESHOLD=15
QUEUE_MODE=false
MAX_CONCURRENT_REQUESTS=2
QUEUE_TIMEOUT_MS=1000
QUEUE_DEPTH_THRESHOLD=4
QUEUE_WAIT_P95_THRESHOLD=0.10
QUEUE_TIMEOUT_RATE_THRESHOLD=0.01
QUEUE_METRICS_WINDOW=30s
LATENCY_METRICS_WINDOW=30s

# Step limits and cooldowns
SCALE_UP_STEP=3
SCALE_DOWN_STEP=1
SCALE_UP_PERSISTENCE_CYCLES=1
SCALE_UP_IMMEDIATE_BREACH_RATIO=1.25
SCALE_UP_COOLDOWN_SECONDS=5
SCALE_DOWN_COOLDOWN_SECONDS=10
MIN_SCALE_ACTION_INTERVAL_SECONDS=5
SCALE_DIRECTION_CHANGE_COOLDOWN_SECONDS=15
SCALE_DOWN_RELEASE_MARGIN=0.85

# Audit output
AUDIT_LOG_PATH=/tmp/autoscaler/audit.jsonl
AUDIT_DB_BACKEND=sqlite
AUDIT_DB_PATH=/tmp/autoscaler/audit.db
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=autoscaler
AUDIT_DB_USER=autoscaler
AUDIT_DB_PASSWORD=autoscaler

# AI agent
AI_AGENT_ENABLED=false
AI_FALLBACK_ON_UNCERTAINTY=true
AI_COVERAGE_THRESHOLD=0.80
AI_MAX_CONFIDENCE=1.00
AI_MODEL=gpt-5.4
AI_TIMEOUT_SECONDS=10
AI_ASYNC_ADVISORY=true
AI_API_KEY=REPLACE_WITH_AI_API_KEY
AI_INPUT_COST_PER_1M_TOKENS=0
AI_OUTPUT_COST_PER_1M_TOKENS=0
AI_MAX_TOTAL_COST_USD=0
AI_MAX_TOTAL_TOKENS=0
EXTRA_AI_ANALYSIS=false

# Latency trend protection for scale-down recommendations
LATENCY_ROLLING_WINDOW=5
LATENCY_SCALE_DOWN_MARGIN=0.85

# Channel logging
LOG_DIR=/tmp/autoscaler/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
LOG_CYCLE_AGGREGATION=5
# channels: lifecycle, errors, metrics, agents, arbitration, safety, scaling, audit
